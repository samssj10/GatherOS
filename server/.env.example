# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rate limiting (window in ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=5
# Check-in attempts per attendee per window (limits guessing the room code)
STAMP_RATE_LIMIT_MAX=10

# Sessions: HMAC secret for the HttpOnly session cookie (min 32 chars; generate a random one)
SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
SESSION_TTL_HOURS=8
# Mock login: this email signs in as the planner; any attendee email signs in as an attendee
PLANNER_EMAIL=planner@gatheros.example.com

# Check-in opens when a session starts and closes when it ends.
# EVENT_START_DATE is day 1 (YYYY-MM-DD, default: today). EVENT_NOW pins "now" for demos and tests,
# e.g. EVENT_NOW=2030-06-03T09:30:00 together with EVENT_START_DATE=2030-06-03 makes the opening keynote live.
EVENT_START_DATE=
EVENT_NOW=
# Showcase mode: loop the event clock through Day 1's first session so one session is always live and
# check-in can always be tried (the room code still changes every real minute). Off by default.
# EVENT_NOW, when set, takes priority.
DEMO_LIVE_LOOP=false

# Hosting (see "Deploying" in the README). SERVE_CLIENT=true makes this server also serve the built
# React app from ../client/dist. TRUST_PROXY_HOPS is how many proxies sit in front of the server
# (1 behind a typical host), so rate limits count real visitors. Both are off by default.
SERVE_CLIENT=false
TRUST_PROXY_HOPS=0
# Temporarily log each visitor's address and forwarding headers to work out TRUST_PROXY_HOPS on a host.
# These are personal data, so turn it back off afterwards.
LOG_CLIENT_ADDRESS=false

# Anthropic (Claude) - used by POST /api/ai/generate-schedule
# ANTHROPIC_BASE_URL is optional (override for proxies or local test doubles)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5
