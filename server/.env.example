# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rate limiting (window in ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AI_RATE_LIMIT_MAX=5

# Sessions: HMAC secret for the HttpOnly session cookie (min 32 chars; generate a random one)
SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
SESSION_TTL_HOURS=8
# Mock login: this email signs in as the planner; any attendee email signs in as an attendee
PLANNER_EMAIL=planner@gatheros.example.com

# Check-in opens when a session starts and closes when it ends.
# EVENT_START_DATE is day 1 (YYYY-MM-DD, default: today). EVENT_NOW pins "now" for demos and tests,
# e.g. EVENT_NOW=2030-06-03T09:30:00 together with EVENT_START_DATE=2030-06-03 makes the opening keynote live.
EVENT_START_DATE=
EVENT_NOW=

# Anthropic (Claude) - used by POST /api/ai/generate-schedule
# ANTHROPIC_BASE_URL is optional (override for proxies or local test doubles)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-haiku-4-5
