{
  "name": "gather-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx}": [
      "npm --prefix client exec eslint -- --fix",
      "bash -c \"cd client && npx tsc -b --noEmit\""
    ],
    "server/**/*.ts": [
      "bash -c \"cd server && npx tsc --noEmit\""
    ]
  }
}
